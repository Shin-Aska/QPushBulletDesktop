      "PBDESK_WEB_PORT": "18768",
      "QT_QPA_PLATFORM": "offscreen",
      "PYTEST_QT_API": "pyqt6",
      "PBDESK_APPLICATION_DIR": "$ZED_WORKTREE_ROOT/.runtime/editor-demo"
